<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 xl:h-20">

    <%# Logo %>
    <%# Icon as image, name as real text: sharp and readable at any size %>
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
      <%= image_tag "rehoboth-icon.webp", alt: "", width: 44, height: 42, class: "h-10 w-auto xl:h-12" %>
      <span class="leading-none">
        <span class="block text-lg font-extrabold tracking-wide text-brand-blue xl:text-xl">REHOBOTH</span>
        <span class="mt-0.5 block text-[0.62rem] font-bold tracking-[0.18em] text-brand-sage-dark xl:text-xs">TRANS ASIA CARGO</span>
      </span>
    <% end %>

    <%# Desktop navigation (1280px and up) %>
    <nav class="hidden items-center gap-1 xl:flex" aria-label="<%= t("nav.main_navigation") %>">
      <% nav_items.each do |key, path| %>
        <%= link_to t("nav.#{key}"), path,
              class: "whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold #{current_page?(path) ? 'text-brand-blue bg-brand-sky/20' : 'text-brand-ink hover:text-brand-blue'}",
              aria: { current: (current_page?(path) ? "page" : nil) } %>
      <% end %>
    </nav>

    <div class="flex items-center gap-2">
      <%# Desktop: language switch + WhatsApp button %>
      <div class="hidden xl:block"><%= render "layouts/language_switch" %></div>

      <%= link_to t("nav.whatsapp"), whatsapp_url(:vietnam),
            target: "_blank", rel: "noopener",
            class: "hidden min-h-11 items-center rounded-full bg-brand-sage-dark px-5 text-sm font-semibold whitespace-nowrap text-white hover:bg-brand-sage xl:inline-flex" %>

      <%# Phone/tablet menu (below 1280px). Works without JavaScript; the menu controller adds close-on-outside-tap and Escape %>
      <details class="relative xl:hidden" data-controller="menu">
        <summary class="inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300 text-brand-ink [&::-webkit-details-marker]:hidden"
                 aria-label="<%= t("nav.menu") %>">
          <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>

        <div class="absolute right-0 mt-2 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
          <nav aria-label="<%= t("nav.main_navigation") %>">
            <% nav_items.each do |key, path| %>
              <%= link_to t("nav.#{key}"), path,
                    class: "flex min-h-11 items-center rounded-lg px-3 text-base font-semibold #{current_page?(path) ? 'text-brand-blue bg-brand-sky/20' : 'text-brand-ink active:bg-slate-100'}",
                    aria: { current: (current_page?(path) ? "page" : nil) } %>
            <% end %>
          </nav>
          <div class="mt-2 flex items-center justify-between border-t border-slate-200 px-3 pt-3">
            <span class="text-sm text-slate-500"><%= t("nav.language") %></span>
            <%= render "layouts/language_switch" %>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
