<h1 class="text-xl font-extrabold"><%= t(".title") %></h1>
<p class="mt-2 text-sm text-slate-600"><%= t(".text") %></p>

<%= form_with url: two_factor_session_path, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :code, t(".code"), class: "block text-sm font-semibold" %>
    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code",
          inputmode: "numeric", pattern: "[0-9 ]*", maxlength: 7,
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-center text-2xl tracking-[0.3em]" %>
  </div>
  <%= form.submit t(".submit"), class: "min-h-12 w-full cursor-pointer rounded-full bg-brand-blue text-base font-bold text-white" %>
<% end %>

<%= link_to t(".back"), new_session_path, class: "mt-4 inline-block text-sm text-brand-blue underline" %>
