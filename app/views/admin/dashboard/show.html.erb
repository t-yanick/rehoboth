<% content_for :title, t(".title") %>

<h1 class="text-2xl font-extrabold"><%= t(".welcome", name: Current.user.name) %></h1>
<p class="mt-1 text-slate-600"><%= t(".role", role: t("admin.roles.#{Current.user.role}")) %></p>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% %w[departures updates clients].each do |key| %>
    <div class="rounded-xl bg-white p-5 shadow-sm">
      <h2 class="font-bold text-brand-blue"><%= t(".cards.#{key}.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t(".cards.#{key}.text") %></p>
      <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500"><%= t(".coming_soon") %></p>
    </div>
  <% end %>
</div>
