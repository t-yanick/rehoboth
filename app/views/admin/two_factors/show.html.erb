<% content_for :title, t(".title") %>

<h1 class="text-2xl font-extrabold"><%= t(".title") %></h1>
<p class="mt-1 text-slate-600"><%= t(".explain") %></p>

<div class="mt-6 rounded-xl bg-white p-5 shadow-sm">
  <% if Current.user.otp_enabled? %>
    <p class="font-semibold text-green-700"><%= t(".enabled", date: l(Current.user.otp_enabled_at.to_date, format: :long)) %></p>
    <% if Current.user.hq_admin? %>
      <p class="mt-2 text-sm text-slate-500"><%= t(".required_note") %></p>
    <% else %>
      <%= button_to t(".turn_off"), admin_two_factor_path, method: :delete,
            class: "mt-4 min-h-11 cursor-pointer rounded-full border border-red-300 px-5 text-sm font-semibold text-red-700" %>
    <% end %>
  <% else %>
    <p class="font-semibold text-slate-500"><%= t(".disabled") %></p>
    <%= link_to t(".turn_on"), new_admin_two_factor_path,
          class: "mt-4 inline-flex min-h-11 items-center rounded-full bg-brand-blue px-5 text-sm font-bold text-white" %>
  <% end %>
</div>
