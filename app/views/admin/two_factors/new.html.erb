<% content_for :title, t(".title") %>

<h1 class="text-2xl font-extrabold"><%= t(".title") %></h1>

<ol class="mt-6 space-y-6 rounded-xl bg-white p-5 shadow-sm">
  <li>
    <p class="font-semibold">1. <%= t(".step1") %></p>
  </li>
  <li>
    <p class="font-semibold">2. <%= t(".step2") %></p>
    <%= image_tag @qr_data_uri, alt: "QR code", width: 224, height: 224, class: "mx-auto mt-4 h-56 w-56" %>
    <p class="mt-3 text-sm text-slate-600"><%= t(".manual") %></p>
    <p class="mt-1 break-all rounded-lg bg-slate-100 px-3 py-2 font-mono text-sm tracking-wider"><%= Current.user.otp_secret.scan(/.{1,4}/).join(" ") %></p>
  </li>
  <li>
    <p class="font-semibold">3. <%= t(".step3") %></p>
    <%= form_with url: admin_two_factor_path, class: "mt-3 space-y-4" do |form| %>
      <%= form.text_field :code, required: true, autocomplete: "one-time-code", inputmode: "numeric",
            pattern: "[0-9 ]*", maxlength: 7, aria: { label: t(".code") },
            class: "block w-full rounded-lg border border-slate-300 px-3 py-3 text-center text-2xl tracking-[0.3em] sm:w-64" %>
      <%= form.submit t(".submit"), class: "min-h-12 cursor-pointer rounded-full bg-brand-blue px-6 font-bold text-white" %>
    <% end %>
  </li>
</ol>
