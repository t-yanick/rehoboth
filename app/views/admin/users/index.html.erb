<% content_for :title, t(".title") %>

<div class="flex items-center justify-between gap-3">
  <h1 class="text-2xl font-extrabold"><%= t(".title") %></h1>
  <%= link_to t(".new"), new_admin_user_path,
        class: "inline-flex min-h-11 items-center rounded-full bg-brand-blue px-5 text-sm font-bold text-white" %>
</div>

<ul class="mt-6 divide-y divide-slate-200 rounded-xl bg-white shadow-sm">
  <% @users.each do |user| %>
    <li>
      <%= link_to edit_admin_user_path(user), class: "flex items-center justify-between gap-3 px-5 py-4" do %>
        <span>
          <span class="block font-bold"><%= user.name %></span>
          <span class="block text-sm text-slate-500"><%= user.email_address %></span>
        </span>
        <span class="text-right text-sm">
          <span class="block font-semibold text-brand-blue"><%= t("admin.roles.#{user.role}") %></span>
          <span class="block <%= user.active? ? 'text-green-700' : 'text-red-600' %>">
            <%= user.active? ? t(".active") : t(".inactive") %>
          </span>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
