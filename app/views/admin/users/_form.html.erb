<% field = "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
<% lbl = "block text-sm font-semibold" %>

<%= form_with model: [ :admin, user ], class: "mt-6 space-y-5 rounded-xl bg-white p-5 shadow-sm" do |f| %>
  <% if user.errors.any? %>
    <ul class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name, t(".name"), class: lbl %>
    <%= f.text_field :name, required: true, class: field %>
  </div>

  <div>
    <%= f.label :email_address, t(".email"), class: lbl %>
    <%= f.email_field :email_address, required: true, autocomplete: "off", class: field %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :role, t(".role"), class: lbl %>
      <%= f.select :role, User::ROLES.map { |r| [ t("admin.roles.#{r}"), r ] }, {}, class: field %>
    </div>
    <div>
      <%= f.label :locale, t(".locale"), class: lbl %>
      <%= f.select :locale, %w[en fr].map { |l| [ t("admin.locales.#{l}"), l ] }, {}, class: field %>
    </div>
  </div>

  <label class="flex min-h-11 items-center gap-3">
    <%= f.check_box :active, class: "h-5 w-5" %>
    <span class="font-semibold"><%= t(".active") %></span>
  </label>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :password, t(".password"), class: lbl %>
      <%= f.password_field :password, autocomplete: "new-password", required: user.new_record?, class: field %>
    </div>
    <div>
      <%= f.label :password_confirmation, t(".password_confirmation"), class: lbl %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: user.new_record?, class: field %>
    </div>
  </div>
  <p class="text-sm text-slate-500"><%= user.new_record? ? t(".password_new_hint") : t(".password_hint") %></p>

  <div class="flex flex-col gap-3 sm:flex-row">
    <%= f.submit t(".save"), class: "min-h-12 cursor-pointer rounded-full bg-brand-blue px-6 font-bold text-white" %>
    <%= link_to t(".cancel"), admin_users_path,
          class: "inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 px-6 font-semibold" %>
  </div>
<% end %>
