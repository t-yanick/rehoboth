<% content_for :title, t(".page_title") %>

<%= render "shared/page_header", title: t(".title"), intro: t(".intro") %>

<section class="mx-auto max-w-6xl px-4 py-10">
  <div class="grid gap-5 md:grid-cols-2">
    <% %i[vietnam china].each do |office| %>
      <div class="rounded-xl border border-slate-200 p-6">
        <h2 class="text-xl font-extrabold text-brand-blue"><%= t(".offices.#{office}") %></h2>
        <p class="mt-3 text-base text-slate-700"><%= site[:warehouses][office][:address] %></p>
        <%= link_to whatsapp_url(office), target: "_blank", rel: "noopener",
              class: "mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-brand-sage-dark px-6 text-base font-bold text-white active:scale-95 sm:w-auto" do %>
          <%= t("nav.whatsapp") %> · <%= site[:whatsapp][office][:display] %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 grid gap-4 text-base text-slate-700 sm:grid-cols-2">
    <p><strong><%= t(".email") %>:</strong> <%= mail_to site[:email], site[:email], class: "text-brand-blue underline" %></p>
    <p><strong><%= t(".hours") %>:</strong> <%= site[:hours] %></p>
  </div>
</section>
