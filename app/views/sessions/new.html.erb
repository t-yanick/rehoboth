<h1 class="text-xl font-extrabold"><%= t(".title") %></h1>

<%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :email_address, t(".email"), class: "block text-sm font-semibold" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address],
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
  </div>
  <div>
    <%= form.label :password, t(".password"), class: "block text-sm font-semibold" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-3 text-base" %>
  </div>
  <%= form.submit t(".submit"), class: "min-h-12 w-full cursor-pointer rounded-full bg-brand-blue text-base font-bold text-white" %>
<% end %>

<%= link_to t(".forgot"), new_password_path, class: "mt-4 inline-block text-sm text-brand-blue underline" %>
