<%# locals: (title:, intro: nil) %>
<section class="bg-gradient-to-b from-brand-sky/25 to-white">
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <h1 class="text-3xl font-extrabold leading-tight text-brand-blue md:text-4xl"><%= title %></h1>
    <% if intro %>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg"><%= intro %></p>
    <% end %>
  </div>
</section>
